{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/hooks/*": [
        "./src/hooks/*"
      ],
      "@/assets/*": [
        "./src/assets/*"
      ],
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "src/.expo/types/**/*.ts"
  ]
}
